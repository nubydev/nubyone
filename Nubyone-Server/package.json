{
  "name": "nubyone-server",
  "version": "1.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run build:css && bun build --production --minify src/index.ts --target bun --outdir dist",
    "build:css": "bun x tailwindcss -i ./src/styles.css -o ./public/assets/tailwind.css --minify",
    "build:prod:win": "bun build --production --minify src/index.ts --compile --target bun-windows-x64 --outfile dist/nubyone-server.exe",
    "build:prod:linux": "bun build --production --minify src/index.ts --compile --target bun-linux-x64 --outfile dist/nubyone-server-linux-x64",
    "watch:css": "bun x tailwindcss -i ./src/styles.css -o ./public/assets/tailwind.css --watch"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "@noble/ciphers": "^2.2.0",
    "@tailwindcss/cli": "^4.1.18",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "flag-icons": "latest",
    "geoip-lite": "latest",
    "jose": "^6.1.3",
    "pdfkit": "^0.18.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/geoip-lite": "latest",
    "@types/pdfkit": "^0.17.5",
    "@types/uuid": "^9.0.7",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "typescript": "^6.0.3"
  }
}
